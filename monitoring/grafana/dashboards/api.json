      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, route) (rate(http_requests_total{job=\"api\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}}"
